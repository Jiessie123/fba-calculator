}
#root .c-purple .ts, #root .c-teal .ts, #root .c-coral .ts,
#root .c-pink .ts, #root .c-gray .ts, #root .c-blue .ts,
#root .c-green .ts, #root .c-amber .ts, #root .c-red .ts {
    fill: var(--node-text-sub) !important;
}

