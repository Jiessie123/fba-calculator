    :root:not([data-widget-theme]) .c-purple { --node-bg: #26215C; --node-border: #7F77DD; --node-text: #EEEDFE; --node-text-sub: #B8B4F5; }
    :root:not([data-widget-theme]) .c-teal   { --node-bg: #04342C; --node-border: #1D9E75; --node-text: #E1F5EE; --node-text-sub: #7DDDC0; }
    :root:not([data-widget-theme]) .c-coral  { --node-bg: #4A1B0C; --node-border: #D85A30; --node-text: #FAECE7; --node-text-sub: #F0A080; }
    :root:not([data-widget-theme]) .c-pink   { --node-bg: #4B1528; --node-border: #D4537E; --node-text: #FBEAF0; --node-text-sub: #F0A0C0; }
    :root:not([data-widget-theme]) .c-gray   { --node-bg: #2C2C2A; --node-border: #888780; --node-text: #F1EFE8; --node-text-sub: #B8B6B0; }
    :root:not([data-widget-theme]) .c-blue   { --node-bg: #042C53; --node-border: #378ADD; --node-text: #E6F1FB; --node-text-sub: #90C4F0; }
    :root:not([data-widget-theme]) .c-green  { --node-bg: #173404; --node-border: #639922; --node-text: #EAF3DE; --node-text-sub: #A0D060; }
